@{
    ViewData["Title"] = "Spotify Remote";
    var error = Context.Request.Query["error"].ToString();
    var isLoggedIn = Context.Session.GetString("access_token") != null;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h1 class="display-4 text-spotify mb-2">♪ Spotify Remote</h1>
        <p class="text-muted mb-4">Control your Spotify Desktop player from your browser.</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        @if (isLoggedIn)
        {
            <a href="/player" class="btn btn-spotify btn-lg px-5">Open Player</a>
            <div class="mt-3">
                <a href="/auth/logout" class="text-muted small">Logout</a>
            </div>
        }
        else
        {
            <a href="/auth/login" class="btn btn-spotify btn-lg px-5">
                Connect Spotify Account
            </a>
            <p class="text-muted small mt-3">
                Requires Spotify Premium and the Spotify desktop app running.
            </p>
        }
    </div>
</div>
